{
  "name": "ADN YouTube Ingest to Transcriber",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "e2f12345-1234-4a21-9d22-123456789abc",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=YOUR_CHANNEL_ID"
      },
      "id": "f5e12345-4321-4b21-9c22-987654321abc",
      "name": "RSS Feed Read",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ $json.mediaUrl }}",
              "parameterType": "form-data"
            },
            {
              "name": "model",
              "value": "whisper-1"
            }
          ]
        }
      },
      "id": "a1b12345-abcd-4f21-9e22-abcdef123456",
      "name": "Whisper API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20240620"
            },
            {
              "name": "system",
              "value": "You are adn.transcriber. You extract 1-3 highly actionable Ideas from raw transcripts."
            },
            {
              "name": "messages",
              "value": "=[{\"role\":\"user\",\"content\":\"{{ $json.text }}\"}]"
            }
          ]
        }
      },
      "id": "b2c12345-dcba-4g21-9f22-fedcba654321",
      "name": "Anthropic adn.transcriber",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_NEXTJS_APP.vercel.app/api/webhooks/n8n-ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SECRET_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "agent",
              "value": "adn.transcriber"
            },
            {
              "name": "payload",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        }
      },
      "id": "c3d12345-fedc-4h21-9g22-12345abcdefg",
      "name": "Webhook to ADN Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "RSS Feed Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RSS Feed Read": {
      "main": [
        [
          {
            "node": "Whisper API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Whisper API": {
      "main": [
        [
          {
            "node": "Anthropic adn.transcriber",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic adn.transcriber": {
      "main": [
        [
          {
            "node": "Webhook to ADN Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
